# Copy to .env.local and fill in. .env.local is gitignored.

# Shared "Lam Soon PSG Platform" Supabase project — the same URL and
# publishable key as the Central Portal and Room Booking.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_REF=your-project-ref

# Production only: ".lamsoonpsg.org" shares the Portal session cookie, and
# unauthenticated visitors are sent to the Portal login. Leave unset
# locally to use the local /login form.
# NEXT_PUBLIC_SUPABASE_COOKIE_DOMAIN=.lamsoonpsg.org
# NEXT_PUBLIC_SUPABASE_COOKIE_NAME=

# Local development only: 1 runs the app against an in-memory demo store
# with a demo worker + office user, so the UI can be tried before the
# tally schema exists in Supabase. Ignored in production builds.
TALLY_DEMO=0
